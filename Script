local function WatchLocalCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    humanoid.Died:Connect(function()
        local tag = humanoid:FindFirstChild("creator") or humanoid:FindFirstChild("Creator")
        local killer = tag and tag:IsA("ObjectValue") and tag.Value
        if killer and killer:IsA("Player") and killer ~= LocalPlayer then
            State.LastKiller = killer
        end
        if State.RevengeActive then
            State.RevengeActive = false
            State.RevengeTarget = nil
            State.ESP = false
            if StopLockOn then StopLockOn() end
            ClearESP()
        end
    end)
end

if LocalPlayer.Character then task.spawn(WatchLocalCharacter, LocalPlayer.Character) end
