RenderCategory = function()
    ClearContent()

    for name, button in pairs(CategoryButtons) do
        local selected = name == State.Category
        button.BackgroundColor3 = selected and C.AccentDark or C.Surface2
        button.TextColor3 = selected and C.White or C.Gray
        local stroke = button:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Color = selected and C.Accent or C.Stroke end
    end

    if State.Category == "IA" then
        RenderIA()
    elseif State.Category == "Combat" then
        RenderCombat()
    elseif State.Category == "ESP" then
        RenderESP()
    elseif State.Category == "Players" then
        RenderPlayers()
    elseif State.Category == "Places" then
        RenderPlaces()
    elseif State.Category == "Watch" then
        RenderWatch()
    elseif State.Category == "Farm" then
        RenderFarm()
    elseif State.Category == "Local Seguro" then
        RenderSafe()
    elseif State.Category == "Settings" then
        RenderSettings()
    end
end

