-- COMBAT / LOCK-ON
--========================================================--

local LockName = "NexusUserLockOn"

local function GetTargetPart(player)
    if not player or player == LocalPlayer then return nil end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return nil end
    if State.LockPart == "Head" then
        return character:FindFirstChild("Head")
    end
    return character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function HasLineOfSight(player, targetPart)
    local camera = Workspace.CurrentCamera
    local character = GetCharacter()
    if not camera or not targetPart or not character then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = true
    local direction = targetPart.Position - camera.CFrame.Position
    local result = Workspace:Raycast(camera.CFrame.Position, direction, params)
    return not result or (player.Character and result.Instance:IsDescendantOf(player.Character))
end

local function IsValidTarget(player)
    if not player or player == LocalPlayer or State.Ignored[player.UserId] then return false end
    if State.RevengeActive and player ~= State.RevengeTarget then return false end
    local part = GetTargetPart(player)
    local root = GetRoot()
    if not part or not root then return false end
    if (part.Position - root.Position).Magnitude > Config.LockRange then return false end
    return HasLineOfSight(player, part)
end

local function FindBestTarget()
    if State.RevengeActive then
        return IsValidTarget(State.RevengeTarget) and State.RevengeTarget or nil
    end
    local root = GetRoot()
    if not root then return nil end
    local best, bestDistance = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if IsValidTarget(player) then
            local part = GetTargetPart(player)
            local distance = part and (part.Position - root.Position).Magnitude or math.huge
            if distance < bestDistance then
                best, bestDistance = player, distance
            end
        end
    end
    return best
end

StopLockOn = function()
    State.LockOn = false
    State.CurrentTarget = nil
    pcall(function() RunService:UnbindFromRenderStep(LockName) end)
end

StartLockOn = function()
    State.LockOn = true
    State.CurrentTarget = FindBestTarget()
    pcall(function() RunService:UnbindFromRenderStep(LockName) end)
    RunService:BindToRenderStep(LockName, Enum.RenderPriority.Camera.Value + 1, function()
        if not State.LockOn then return end
        local camera = Workspace.CurrentCamera
        if not camera then return end
        if not IsValidTarget(State.CurrentTarget) then
            State.CurrentTarget = FindBestTarget()
        end
        local target = State.CurrentTarget
        local part = target and GetTargetPart(target)
        if part and HasLineOfSight(target, part) then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, part.Position)
        end
    end)
end

local function RenderCombat()
    Section("LOCK-ON")
    Toggle("Lock-On", State.LockOn, function()
        if State.LockOn then StopLockOn() else StartLockOn() end
        RenderCategory()
    end)
    Button("Alcance: " .. Config.LockRange .. " studs", function()
        Config.LockRange = Config.LockRange == 150 and 250 or (Config.LockRange == 250 and 350 or 150)
        RenderCategory()
    end)
    Button("Parte da mira: " .. State.LockPart, function()
        State.LockPart = State.LockPart == "Head" and "Torso" or "Head"
        if State.LockOn then State.CurrentTarget = FindBestTarget() end
        RenderCategory()
    end)
    Section("ALVO ATUAL")
    local target = State.CurrentTarget
    local info = Label(target and (target.DisplayName .. "  @" .. target.Name) or "Nenhum alvo", 32)
    info.TextColor3 = target and C.Green or C.Gray
    Section("IGNORAR JOGADORES")
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local ignored = State.Ignored[player.UserId] == true
            Button((ignored and "×  " or "✓  ") .. player.DisplayName .. "  @" .. player.Name, function()
                State.Ignored[player.UserId] = not State.Ignored[player.UserId]
                if State.CurrentTarget == player then State.CurrentTarget = nil end
                if State.LockOn then State.CurrentTarget = FindBestTarget() end
                RenderCategory()
            end, ignored and Color3.fromRGB(75, 30, 38) or C.Surface2)
        end
    end
end

