--========================================================--
-- DRAG FLOATING BUTTON
--========================================================--

local dragStart
local startPosition
local dragging = false
local dragInput

Float.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragStart = input.Position
        startPosition = Float.Position
        dragging = false
        dragInput = input
    end
end)

Float.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        if not dragStart then return end
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            dragging = true
            Float.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragInput and input == dragInput and input.UserInputType == Enum.UserInputType.Touch then
        -- Touch movement is handled by Float.InputChanged.
    end
end)

Float.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragStart = nil
        dragInput = nil
    end
end)

Float.Activated:Connect(function()
    if dragging then
        dragging = false
        return
    end
    Main.Visible = not Main.Visible
    if Main.Visible then RenderCategory() end
end)

Close.Activated:Connect(function()
    Main.Visible = false
end)

