--========================================================--
-- FARM
--========================================================--

local function GetFarmRoot(object)
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    end
    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function GetFarmPrompt(object)
    return object:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function GetSpills()
    local list = {}
    for _, object in ipairs(Workspace:GetDescendants()) do
        if string.lower(object.Name):sub(1, 5) == "spill" then
            local root = GetFarmRoot(object)
            local prompt = GetFarmPrompt(object)
            if root and prompt and prompt.Enabled then
                table.insert(list, {Object = object, Root = root, Prompt = prompt})
            end
        end
    end
    table.sort(list, function(a, b) return a.Object.Name < b.Object.Name end)
    return list
end

local function FarmOne(spill)
    if not State.FarmRunning then return false end
    local object = spill.Object
    if not object or not object.Parent then return false end
    local objectRoot = GetFarmRoot(object)
    local root = GetRoot()
    if not objectRoot or not root then return false end
    local prompt = GetFarmPrompt(object)
    if not prompt or not prompt.Enabled then return true end

    root.CFrame = objectRoot.CFrame + Vector3.new(0, 2.5, 0)
    task.wait(0.15)
    if not State.FarmRunning then return false end

    prompt = GetFarmPrompt(object)
    if not prompt or not prompt.Enabled then return true end

    local ok = pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(0.1, prompt.HoldDuration))
        prompt:InputHoldEnd()
    end)
    if not ok then return false end
    task.wait(0.25)
    return not object.Parent or not GetFarmPrompt(object) or not GetFarmPrompt(object).Enabled
end

local function StartAutoFarm()
    if State.FarmRunning then return end
    State.FarmRunning = true
    task.spawn(function()
        while State.FarmRunning do
            local spills = GetSpills()
            if #spills == 0 then
                task.wait(0.5)
            else
                for _, spill in ipairs(spills) do
                    if not State.FarmRunning then break end
                    local completed = false
                    for _ = 1, 3 do
                        if not State.FarmRunning then break end
                        completed = FarmOne(spill)
                        if completed then break end
                        task.wait(0.15)
                    end
                end
                if not State.FarmLoop then break end
                task.wait(0.25)
            end
        end
        State.FarmRunning = false
    end)
end

local function RenderFarm()
    Section("AUTO FARM")
    Label("Procura objetos cujo nome começa com 'spill' e que tenham ProximityPrompt ativo.", 48)
    local spills = GetSpills()
    local status = Label((State.FarmRunning and "● FARM ATIVO\n" or "○ FARM PARADO\n") .. #spills .. " spills encontrados", 42)
    status.TextColor3 = State.FarmRunning and C.Green or C.Gray
    Button(State.FarmRunning and "■ PARAR FARM" or "▶ INICIAR FARM", function()
        if State.FarmRunning then
            State.FarmRunning = false
        else
            StartAutoFarm()
        end
        RenderCategory()
    end, State.FarmRunning and Color3.fromRGB(80, 32, 40) or C.AccentDark)
    Toggle("Loop automático", State.FarmLoop, function()
        State.FarmLoop = not State.FarmLoop
        RenderCategory()
    end)
    Button("Atualizar lista de spills", function() RenderCategory() end)
end

