local ESPFolder = New("Folder", {Name = "NexusESP"}, Gui)

ClearESP = function()
    for _, object in ipairs(ESPFolder:GetChildren()) do object:Destroy() end
end

local function UpdateESP()
    if not State.ESP then ClearESP(); return end

    local activeIds = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local head = character and character:FindFirstChild("Head")
            local allowed = not State.RevengeActive or player == State.RevengeTarget
            local old = ESPFolder:FindFirstChild(tostring(player.UserId))

            if head and humanoid and humanoid.Health > 0 and allowed then
                activeIds[tostring(player.UserId)] = true
                if old and old.Adornee ~= head then
                    old:Destroy()
                    old = nil
                end
                if not old then
                    old = New("BillboardGui", {
                        Name = tostring(player.UserId),
                        Adornee = head,
                        AlwaysOnTop = true,
                        Size = UDim2.fromOffset(200, 28),
                        StudsOffset = Vector3.new(0, 3, 0),
                    }, ESPFolder)
                    New("TextLabel", {
                        Size = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        Text = player.DisplayName .. "  @" .. player.Name,
                        TextColor3 = C.White,
                        TextStrokeTransparency = 0.15,
                        TextSize = 11,
                        Font = Enum.Font.GothamBold,
                    }, old)
                else
                    local label = old:FindFirstChildOfClass("TextLabel")
                    if label then label.Text = player.DisplayName .. "  @" .. player.Name end
                end
            elseif old then
                old:Destroy()
            end
        end
    end

    for _, object in ipairs(ESPFolder:GetChildren()) do
        if not activeIds[object.Name] then object:Destroy() end
    end

    if State.RevengeActive then
        local target = State.RevengeTarget
        local humanoid = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if not target or target.Parent ~= Players or not humanoid or humanoid.Health <= 0 then
            State.RevengeActive = false
            State.RevengeTarget = nil
            State.ESP = false
            if StopLockOn then StopLockOn() end
            ClearESP()
        end
    end
end

