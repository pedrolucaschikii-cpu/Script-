--========================================================--
-- LOCAL SAFE PLATFORM
-- This is client-created for testing in your own place.
-- Server-authoritative games should implement/validate this
-- mechanic on the server for reliable multiplayer behavior.
--========================================================--

local function FindGroundY(x, z, ignoreCharacter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {}
    if ignoreCharacter and GetCharacter() then
        table.insert(excluded, GetCharacter())
    end
    if State.SafePlatform then
        table.insert(excluded, State.SafePlatform)
    end
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = false

    local result = Workspace:Raycast(
        Vector3.new(x, 100000, z),
        Vector3.new(0, -200000, 0),
        params
    )
    return result and result.Position.Y or 0
end

local function EnsureSafePlatform()
    if State.SafePlatform and State.SafePlatform.Parent then
        return State.SafePlatform
    end

    local platform = New("Part", {
        Name = "NexusLocalSafePlatform_" .. LocalPlayer.UserId,
        Anchored = true,
        CanCollide = true,
        CanTouch = true,
        CanQuery = true,
        Size = Vector3.new(Config.SafeSize, Config.SafeThickness, Config.SafeSize),
        Material = Enum.Material.SmoothPlastic,
        Color = Color3.fromRGB(105, 111, 122),
        Transparency = 0.18,
        TopSurface = Enum.SurfaceType.Smooth,
        BottomSurface = Enum.SurfaceType.Smooth,
        CastShadow = false,
    }, Workspace)

    local top = New("Part", {
        Name = "NexusSafePlatformAccent",
        Anchored = true,
        CanCollide = false,
        CanTouch = false,
        CanQuery = false,
        Size = Vector3.new(Config.SafeSize, 0.25, Config.SafeSize),
        Material = Enum.Material.SmoothPlastic,
        Color = Color3.fromRGB(135, 141, 151),
        Transparency = 0.72,
        CastShadow = false,
    }, Workspace)

    State.SafePlatform = platform
    platform:SetAttribute("NexusOwnerUserId", LocalPlayer.UserId)
    platform:SetAttribute("NexusAccentName", top.Name)

    -- Keep the accent attached logically to the platform position.
    State.SafeAccent = top
    return platform
end

local function PositionSafePlatform(x, y, z)
    local platform = EnsureSafePlatform()
    platform.CFrame = CFrame.new(x, y, z)
    if State.SafeAccent and State.SafeAccent.Parent then
        State.SafeAccent.CFrame = CFrame.new(x, y + Config.SafeThickness / 2 + 0.125, z)
    end
end

local function ActivateSafe()
    if State.SafeActive then return end

    local character = GetCharacter()
    local root = GetRoot(character)
    local humanoid = GetHumanoid(character)
    if not root or not humanoid or humanoid.Health <= 0 then
        Status.Text = "● NO CHARACTER"
        Status.TextColor3 = C.Red
        return
    end

    local groundY = FindGroundY(root.Position.X, root.Position.Z, true)
    local platformY = math.max(root.Position.Y + Config.SafeHeight, groundY + Config.SafeHeight)
    State.SafeReturnXZ = Vector3.new(root.Position.X, 0, root.Position.Z)
    State.SafePlatformY = platformY
    PositionSafePlatform(root.Position.X, platformY, root.Position.Z)

    State.SafeActive = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(root.Position.X, platformY + Config.SafeThickness / 2 + 4, root.Position.Z)
    Status.Text = "● SAFE ON"
    Status.TextColor3 = C.Green
end

local function DeactivateSafe()
    if not State.SafeActive then return end

    local root = GetRoot()
    if root then
        local x, z = root.Position.X, root.Position.Z
        local groundY = FindGroundY(x, z, true)
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(x, groundY + 5, z)
    end

    State.SafeActive = false
    Status.Text = "● READY"
    Status.TextColor3 = C.Green
end

local function ToggleSafe()
    if State.SafeActive then
        DeactivateSafe()
    else
        ActivateSafe()
    end
end

